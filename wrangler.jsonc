{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ckan-mcp-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "5ce3bbdca0434accb3987d8eb384a65f",
			"preview_id": "00000000000000000000000000000001"
		}
	],
	"d1_databases": [
		{
			"binding": "LOG_DB",
			"database_name": "ckan-mcp-logs",
			"database_id": "348767bd-65ed-4f48-9d9b-6366365a23da"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 4 * * *"
		]
	}
}
