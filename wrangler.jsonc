{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ckan-mcp-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "00000000000000000000000000000000",
			"preview_id": "00000000000000000000000000000001"
		}
	],
	"d1_databases": [
		{
			"binding": "LOG_DB",
			"database_name": "ckan-mcp-logs",
			"database_id": "00000000-0000-0000-0000-000000000001"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": ["0 4 * * *"]
	}
}
