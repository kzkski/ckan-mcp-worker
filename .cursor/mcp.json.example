{
  "mcpServers": {
    "ckan-open-data-local": {
      "command": "node",
      "args": ["scripts/mcp-stdio-bridge.mjs"],
      "env": {
        "CKAN_MCP_BASE_URL": "http://localhost:8787"
      }
    },
    "ckan-open-data-production": {
      "command": "node",
      "args": ["scripts/mcp-stdio-bridge.mjs"],
      "env": {
        "CKAN_MCP_BASE_URL": "https://ckan-mcp-worker.YOUR_SUBDOMAIN.workers.dev"
      }
    }
  }
}
