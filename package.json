{
  "name": "ckan-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ckan-mcp-logs --local",
    "db:migrate:remote": "wrangler d1 migrations apply ckan-mcp-logs --remote",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "setup:prod": "bash scripts/setup-prod.sh",
    "deploy:prod": "wrangler d1 migrations apply ckan-mcp-logs --remote && wrangler deploy",
    "mcp:bridge": "node scripts/mcp-stdio-bridge.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.9.1",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.23"
  }
}
